{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "server.mjs",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "assets.json",
          "the-test.html",
          "analytics-client.js"
        ],
        "maxDuration": 120
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/server.mjs"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/emails",
      "schedule": "0 7 * * *"
    }
  ]
}
